# Configuracao local de exemplo — SPS (Sistema Para Saloes)
# Copie este arquivo para .env e ajuste os valores no seu ambiente local.
# Nunca versione o arquivo .env real.

DEBUG=True
SECRET_KEY=sps-dev-secret-key-alterar-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Banco de dados (PostgreSQL padrao da stack; SQLite suportado apenas para fallback de verificacao local se USE_SQLITE_FALLBACK=True)
DATABASE_URL=psql://sps_user:sps_dev_password@127.0.0.1:5432/sps_dev
USE_SQLITE_FALLBACK=False

# Email nativo do Django (console backend por padrao em desenvolvimento)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=nao-responda@sps.local

# Celery, RabbitMQ e Redis
CELERY_BROKER_URL=amqp://sps_mq:sps_mq_dev_password@127.0.0.1:5672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_CACHE_URL=redis://127.0.0.1:6379/0

# Assistente Gerencial Interno de IA (a_definir)
LLM_MODEL=a_definir
LLM_API_KEY=
